# rigs.env: where things are on the two boxes (copy to rigs.env next to run_ab.sh and fill in; never commit it).
# Front = the box that serves the API (layers [0,24)); back = the box with layers [24,45) + NextN + head.
FRONT_SSH=user@front-host
BACK_SSH=user@back-host
API_URL=http://front-host:8090
API_KEY_FILE=~/.config/maya/api-key          # on the machine that runs run_ab.sh (bare key)
STOP_FLAG_DIR=~/.config/maya                 # optional: a file CLAUDE_STOP here aborts between steps

# systemd units of production (stopped before a run, started again with --restore)
FRONT_UNIT=maya-front
BACK_UNIT=maya-back

# production binaries (defaults for --front-bin / --back-bin) and launch files (only ever COPIED, never edited)
FRONT_BIN_PROD=/path/front/src/build/maya
BACK_BIN_PROD=/path/back/src/build/maya
FRONT_CFG=/path/front/p3/p3-front.json       # maya.py server config the front unit starts with
FRONT_MAYA_SH=/path/front/src/maya.sh        # the launcher the front unit runs
BACK_RUN_SH=/path/back/p3/run-back.sh        # the back unit's ExecStart script (MODE serve)
FRONT_KL_SH=/path/front/p3/run-front-kl2.sh  # KL CLI scripts with production settings, binary via BIN=
BACK_KL_SH=/path/back/p3/run-back-kl2.sh
KL_INPUT=s2

# scratch dirs for run copies, logs and dumps (one sub-dir per label)
FRONT_RUN_ROOT=/path/front/tp-val-runs
BACK_RUN_ROOT=/path/back/tp-val-runs

# KL references (on the front, where the comparison runs) and a python with numpy there
KL_REF2B=/path/front/ref/kl/ref2b/s2.r1.f32
KL_TWIN2=/path/front/kl/twin2/s2.f32         # copied from KL_TWIN2_SRC on the back on first use if missing
KL_TWIN2_SRC=/path/back/kl/p10-new1.f32
KL_TWIN2_SHA=70f47cf80330296af61f3a25703e3cb18636dcd52e95e5380afca4f0b50a5870
FRONT_PY=/path/front/src/.venv/bin/python

# fixed bench corpus: src/core/*.cu of this commit, read from this repo on the front
CORPUS_REPO=/path/front/src
CORPUS_COMMIT=371b63d
GPU_LOCK=/tmp/maya-gpu.lock
